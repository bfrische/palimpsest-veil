{
  "id": "com.palimpsest.veil",
  "name": "Palimpsest Veil",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "24.4.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "network": {
      "domains": ["http://localhost:8760", "http://127.0.0.1:8760"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "veilPanel",
      "label": { "default": "Palimpsest Veil" },
      "minimumSize": { "width": 230, "height": 320 },
      "maximumSize": { "width": 800, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 520 },
      "preferredFloatingSize": { "width": 320, "height": 560 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"],
          "species": ["generic"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["generic"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"],
      "species": ["pluginList"]
    }
  ]
}
