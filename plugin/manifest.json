{
  "manifestVersion": 5,
  "id": "com.palimpsest.veil",
  "name": "Palimpsest Veil",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    { "app": "PS", "minVersion": "24.2.0" }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "veilPanel",
      "label": { "default": "Palimpsest Veil" },
      "minimumSize": { "width": 230, "height": 320 },
      "maximumSize": { "width": 800, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 500 },
      "preferredFloatingSize": { "width": 320, "height": 540 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": ["http://localhost:8760", "http://127.0.0.1:8760"]
    }
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lighter", "light", "lightest"]
    }
  ]
}
